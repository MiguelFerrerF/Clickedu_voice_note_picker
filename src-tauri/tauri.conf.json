{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gestor de Notas",
  "version": "2.0.0",
  "identifier": "es.gestornotas.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Gestor de Notas",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "copyright": "© 2026 Miguel Ferrer",
    "shortDescription": "Dictado de notas por voz para Clickedu",
    "longDescription": "Pon las notas de tus alumnos dictándolas por voz o con el teclado, sobre las plantillas de Clickedu, y expórtalas para importarlas en Clickedu."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU5OUZGQTRCMjFFMTZCQjQKUldTMGErRWhTL3FmNlhXaUhjMkNESHpPLzN6cTd3cm04L1NkSU5aNmhtb0FBa0didEh2bTd6NlEK",
      "endpoints": [
        "https://github.com/MiguelFerrerF/Clickedu_voice_note_picker/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
